# ==============================================================================
# Spendly - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and fill in your Firebase configuration values.
# To obtain these credentials:
# 1. Open the Firebase Console (https://console.firebase.google.com/)
# 2. Select or create your Firebase project
# 3. Go to Project Settings (gear icon) -> General
# 4. Under "Your apps", select your Web app (</>) or create one
# 5. Copy the configuration keys into your local '.env' file
# ==============================================================================

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
